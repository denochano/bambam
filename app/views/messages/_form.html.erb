<%= form_with model: [element, message] do |f| %>

  <div class="d-flex align-items-center gap-2">

    <%= f.text_area :content,
    placeholder: "Write here how you would like to improve this component...",
    class: "form-control rounded-pill px-4",
    rows: 2,
    style: "
      resize: none;
      min-height: 50px;
    " %>

    <%= f.submit "➜",
    class: "btn btn-dark rounded-circle",
    style: "
      width: 50px;
      height: 50px;
    " %>

  </div>

<% end %>
