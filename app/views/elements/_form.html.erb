<div data-controller="fab-form"
     class="position-fixed bottom-0 end-0 p-4"
     style="z-index: 1050; pointer-events: none;">

  <%# Popup card — always in the DOM, just visually hidden %>
  <div data-fab-form-target="popup" class="fab-popup card shadow-lg mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-semibold" >Create an element</span>
      <button type="button"
              class="btn-close"
              data-action="fab-form#toggle"
              aria-label="Close">
      </button>
    </div>
    <div class="card-body">
      <%= simple_form_for [theme, element] do |f| %>
        <%= f.input :name %>
        <%= f.simple_fields_for :messages do |message_form| %>
          <%= message_form.input :content %>
          <%= message_form.input :role, as: :hidden, input_html: { value: "user"} %>
        <% end %>
        <%= f.submit 'Submit', class: 'btn button-1' %>
      <% end %>
    </div>
  </div>

  <%# Floating action button %>
  <div class="d-flex justify-content-end">
    <button type ="button"
            data-fab-form-target="button"
            data-action="fab-form#toggle"
            class="btn button-1 fab-circle rounded-circle shadow d-flex align-items-center justify-content-center"
            style="width: 52px; height: 52px;"
            aria-label="Open form">
      <i class="bi bi-plus-lg"></i>
    </button>
  </div>
</div>
