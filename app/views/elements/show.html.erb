<% @element.theme.elements.each do |element| %>
  <style><%= element.css_code %></style>
<% end %>

<style>
  body {
    background-color: <%= @element.theme.background %> !important
  }
</style>

<div class="container style="max-width: 1500px">

  <div class="d-flex align-items-center">
    <h1 class="py-3 header-1 position-relative">
      <i class="fa-solid fa-caret-left"></i> <%= @element.theme.name %>
      <%= link_to "",
      theme_path(@element.theme),
      class:"header-link" %>
    </h1>

    <span class="header-2 ms-2">
      <%= @element.name %>
    </span>
  </div>

  <hr>
    <div class="row p-5" style="background-color: color-mix(in srgb, <%= @element.theme.background %> 80%, white);">
      <div class="col-6">
        <h4 class="header-2 mb-4"> Request Update </h4>
        <div class="card h-90 bg-white rounded">
          <div class="card-body" style="background-color: <%= @element.theme.background %>">
            <div id="messages" class="mb-2"> <%= render @messages %> </div> <!-- This line: automatically renders: messages/_message.html.erb-->
            <div id="new_message"> <%= render "messages/form", element: @element, message: @message %></div>
          </div>
        </div>
      </div>
      <div class="col-6">
        <h4 class="header-2 mb-4">Preview</h4>
        <div class="border-0 d-flex align-items-center">
          <style><%= @element.css_code %></style>
          <% if @element.html_code.present? %>
            <%= @element.html_code.html_safe %>
          <% end %>
        </div>
        <div class = "card m-3 p-3" style = "background-color: <%= @element.theme.background %>">
          <ul class="nav tabs-underlined" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
              <span style="color: <%= @element.theme.header_color_code %>" class="nav-link tab-underlined active" id="html-tab" data-bs-toggle="tab" data-bs-target="#html-tab-pane-<%= @element.id %>" role="tab" aria-controls="html-tab-pane-<%= @element.id %>" aria-selected="true">HTML</span>
            </li>
            <li class="nav-item" role="presentation">
              <span style="color: <%= @element.theme.header_color_code %>" class="nav-link tab-underlined" id="css-tab" data-bs-toggle="tab" data-bs-target="#css-tab-pane-<%= @element.id %>" role="tab" aria-controls="css-tab-pane-<%= @element.id %>" aria-selected="false">CSS</span>
            </li>
          </ul>
          <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade py-3 show active" id="html-tab-pane-<%= @element.id %>" role="tabpanel" aria-labelledby="html-tab" tabindex="0">
              <code style="color: <%= @element.theme.header_one_color_code %>;"><pre><%= @element.html_code %></pre></code>
            </div>
            <div class="tab-pane fade py-3" id="css-tab-pane-<%= @element.id %>" role="tabpanel" aria-labelledby="css-tab" tabindex="0">
              <code style="color: <%= @element.theme.header_one_color_code %>;"><pre><%= @element.css_code %></pre></code>
            </div>
          </div>
        </div>
      </div>
    </div>
</div>
