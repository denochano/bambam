<style>
  body {
    background-color: <%= @theme.background %> !important
  }
</style>

<div style="--theme-bg: <%= @theme.background %>;">
  <div class="container mt-5" style="max-width: 1000px">
    <h2 class="header-1">
      Welcome to <%= @theme.name %>
    </h2>
    <p class="mt-3 text-cente header-2">
      <%= @theme.specs %>
    </p>
    <div class="container">
      <%= render 'elements/form', element: @element, theme: @theme %>
    </div>
    <br>
    <hr>
    <div class="container">
      <% @theme.elements.each do |element| %>
        <div class="element-card my-3 position-relative">

          <style><%= element.css_code %></style>
          <% if element.html_code.present? %>
            <%= element.html_code.html_safe %>
          <% end %>
          <div class = "card m-3 p-3" style = "background-color: <%= @theme.background %>">
            <ul class="nav tabs-underlined" id="myTab" role="tablist">
              <li class="nav-item" role="presentation">
                <span style="color: <%= @theme.header_color_code %>" class="nav-link tab-underlined active" id="html-tab" data-bs-toggle="tab" data-bs-target="#html-tab-pane-<%= element.id %>" role="tab" aria-controls="html-tab-pane-<%= element.id %>" aria-selected="true">HTML</span>
              </li>

              <li class="nav-item" role="presentation">
                <span style="color: <%= @theme.header_color_code %>" class="nav-link tab-underlined" id="css-tab" data-bs-toggle="tab" data-bs-target="#css-tab-pane-<%= element.id %>" role="tab" aria-controls="css-tab-pane-<%= element.id %>" aria-selected="false">CSS</span>
              </li>

              <li class="nav-item" role="presentation">
                <span style="color: <%= @theme.header_color_code %>" class="nav-link tab-underlined" data-bs-toggle="tab" role="tab" aria-controls="css-tab-pane-<%= element.id %>" aria-selected="false">
                  <%= link_to element_path(element), style: "color: #{@theme.header_color_code}", class: "text-decoration-none" do %>
                    Edit <i class="fa-solid fa-up-right-from-square"></i>
                  <% end %>

                  </span>
              </li>
            </ul>
            <div class="tab-content" id="myTabContent">
              <div class="tab-pane fade py-3 show active" id="html-tab-pane-<%= element.id %>" role="tabpanel" aria-labelledby="html-tab" tabindex="0">
                <code style="color: <%= @theme.header_one_color_code %>;"><pre><%= element.html_code %></pre></code>
              </div>
              <div class="tab-pane fade py-3" id="css-tab-pane-<%= element.id %>" role="tabpanel" aria-labelledby="css-tab" tabindex="0">
                <code style="color: <%= @theme.header_one_color_code %>;"><pre><%= element.css_code %></pre></code>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
