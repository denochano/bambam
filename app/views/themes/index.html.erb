
  <div class="themes-index-page">
    <div class="container mt-4 themes-index-container">
      <div class="themes-index-actions mb-5">
        <%= link_to "Back to Home", root_path, class:"backhome-btn"%>
        <%= link_to "Add a new Theme", new_theme_path, class:"bb-btn-primary bb-btn-small"%>
      </div>
      <div class="row justify-content-center g-4">
        <% @themes.each do |theme| %>

          <div class="col-6 col-lg-4 col-xl-3">

            <div class="card shadow-sm border-0 h-100">

              <%= link_to theme_path(theme),
              class: "text-decoration-none text-dark w-100" do %>

                <%= image_tag "theme.webp",
                class: "card-img-top",
                style: "
                  height: 220px;
                  object-fit: cover;
                " %>

                <div class="card-body">

                  <h5 class="fw-bold mb-2">
                    <%= theme.name %>
                  </h5>

                  <p class="text-muted mb-0">
                    <%= truncate(theme.specs, length: 80) %>
                  </p>

                </div>

              <% end %>

            </div>

          </div>

        <% end %>

      </div>

  </div>
</div>>
