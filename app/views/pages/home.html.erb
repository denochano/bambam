<%# <h1>Pages#home</h1>
<p>Find me in app/views/pages/home.html.erb</p> %>

<!-- app/views/pages/home.html.erb -->
<%# app/views/pages/home.html.erb %>

<div class="bb-page">
  <div class="bb-dot bb-dot-1"></div>
  <div class="bb-dot bb-dot-2"></div>
  <div class="bb-dot bb-dot-3"></div>
  <div class="bb-dot bb-dot-4"></div>

  <div class="bb-badge">UI Kit Builder</div>

  <h1 class="bb-title">Bam<span>bam</span></h1>

  <p class="bb-subtitle">Design and share beautiful UI themes — fast, intuitive, and yours.</p>

  <div class="bb-actions">
    <%= link_to new_theme_path, class: "bb-btn-primary" do %>
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Create a Theme
    <% end %>

    <%= link_to themes_path, class: "bb-btn-secondary" do %>
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      See All Themes
    <% end %>
  </div>
</div>
