<% show_page = (controller_name == "themes" && action_name == "show") || (controller_name == "elements" && action_name == "show") %>
<% login_page = controller_name == "sessions" && action_name == "new" %>
<nav class="navbar navbar-expand-sm navbar-light navbar-lewagon <%= 'navbar-bb-bg' unless show_page %>">
  <div class="container-fluid">
    <div class="navbar-brand-spacer"></div>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <% unless current_page?(root_path) || login_page %>
        <ul class="navbar-nav me-auto">
          <li class="nav-item navbar-buttons">
            <% unless show_page %>
              <%= link_to "Home", root_path, class: "backhome-btn" %>
            <% end %>

            <% unless current_page?(new_theme_path) %>
              <%= link_to "Create Theme",
                          new_theme_path,
                          class: (show_page ? "button-1 text-decoration-none" : "bb-btn-primary") %>
            <% end %>

            <% unless current_page?(themes_path) %>
              <%= link_to "Return to Themes",
                          themes_path,
                          class: (show_page ? "button-1 text-decoration-none" : "bb-btn-secondary bb-btn-small") %>
            <% end %>
          </li>
        </ul>
      <% end %>

      <ul class="navbar-nav ms-auto">
        <% if user_signed_in? %>
          <li class="nav-item dropdown">
            <a href="#" class="avatar" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              <%= image_tag "https://i.ytimg.com/vi/-lXjB1TfGKU/hq720.jpg?sqp=-oaymwEhCK4FEIIDSFryq4qpAxMIARUAAAAAGAElAADIQj0AgKJD&rs=AOn4CLBwsJK7ENY9gdRwX9w83iWNBGX5IA", class: "avatar", alt: "dropdown menu" %>
            </a>

            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item" %>
            </div>
          </li>
        <% elsif !login_page %>
          <li class="nav-item">
            <%= link_to "Login", new_user_session_path, class: "login-btn" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
